<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/navy_medium"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Filter Listings"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:layout_marginBottom="16dp" />

    <!-- Price Range -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Price Range (BWP)"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/white_40"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <EditText
            android:id="@+id/etMinPrice"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:hint="Min"
            android:inputType="number"
            android:background="@drawable/bg_card_listing"
            android:textColor="@color/white"
            android:textColorHint="@color/white_40"
            android:padding="12dp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-"
            android:textColor="@color/white"
            android:layout_marginHorizontal="4dp"
            android:layout_gravity="center" />

        <EditText
            android:id="@+id/etMaxPrice"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:hint="Max"
            android:inputType="number"
            android:background="@drawable/bg_card_listing"
            android:textColor="@color/white"
            android:textColorHint="@color/white_40"
            android:padding="12dp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Location -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Location"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/white_40"
        android:layout_marginBottom="8dp" />

    <Spinner
        android:id="@+id/spLocation"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_card_listing"
        android:layout_marginBottom="16dp" />

    <!-- Room Type -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Room Type"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/white_40"
        android:layout_marginBottom="8dp" />

    <Spinner
        android:id="@+id/spType"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_card_listing"
        android:layout_marginBottom="16dp" />

    <!-- Availability Date -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Available From"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/white_40"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnPickDate"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="Select Date"
        android:background="@drawable/bg_card_listing"
        android:textColor="@color/white"
        android:textAllCaps="false"
        android:gravity="start|center_vertical"
        android:paddingStart="12dp"
        android:layout_marginBottom="24dp" />

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnResetFilters"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="Reset"
            android:background="@drawable/bg_button_secondary"
            android:textColor="@color/white_40"
            android:textSize="12sp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnApplyFilters"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="Apply"
            android:background="@drawable/bg_button_primary"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

</LinearLayout>
