<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/navy_dark"
    android:padding="16dp">

    <!-- Filter Button -->
    <Button
        android:id="@+id/btnFilter"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="🔍 Filter Listings"
        android:background="@drawable/bg_button_secondary"
        android:textColor="@color/blue_light"
        android:textSize="12sp"
        android:layout_marginBottom="16dp" />

    <!-- Results Count -->
    <TextView
        android:id="@+id/tvResultsCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0 listings available"
        android:textSize="11sp"
        android:textColor="@color/white_40"
        android:layout_marginBottom="12dp" />

    <!-- Type Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipAll"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="All"
                android:background="@drawable/bg_role_selected_student"
                android:paddingHorizontal="16dp"
                android:gravity="center"
                android:textColor="@color/blue_light"
                android:textSize="11sp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chipEnsuite"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Ensuite"
                android:background="@drawable/bg_role_card"
                android:paddingHorizontal="16dp"
                android:gravity="center"
                android:textColor="@color/white_40"
                android:textSize="11sp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chipSingle"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Single"
                android:background="@drawable/bg_role_card"
                android:paddingHorizontal="16dp"
                android:gravity="center"
                android:textColor="@color/white_40"
                android:textSize="11sp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chipShared"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Shared"
                android:background="@drawable/bg_role_card"
                android:paddingHorizontal="16dp"
                android:gravity="center"
                android:textColor="@color/white_40"
                android:textSize="11sp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Listings RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewListings"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Empty State -->
    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🏠\nNo listings found"
        android:textSize="14sp"
        android:textColor="@color/white_40"
        android:layout_gravity="center"
        android:gravity="center"
        android:visibility="gone" />

</LinearLayout>